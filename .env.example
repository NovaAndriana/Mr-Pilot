# Contoh isi data/.env (dibuat otomatis oleh `setup`). JANGAN commit file .env ke git.
GITLAB_URL=https://code.idas.id
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_VERIFY_SSL=true
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789
REVIEW_MODE=bot_then_llm

# AI: isi yang dipakai saja (urutan & detail di dashboard > AI)
# CLAUDE_CODE_OAUTH_TOKEN = hasil `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
LOCAL_AI_ENABLED=false
LOCAL_AI_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=qwen2.5-coder:14b

TEAMS_MODE=power_automate
TEAMS_FLOW_URL=https://prod-00.westus.logic.azure.com/workflows/...
CODE_QUALITY_ENABLED=true
COMMIT_COMMENTS=true
DASHBOARD_PASSWORD=ganti-dengan-password-kuat

# Saat merge: ask = tombol Merge (branch tetap) + Merge & hapus branch | keep | delete
MERGE_SOURCE_BRANCH=ask
